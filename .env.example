# ─────────────────────────────────────────────────────────────
# CampusIQ — environment template
# Copy to `.env` and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local embedded PostgreSQL (started by `npm run pg:start`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/campusiq?schema=public"

# Set to 1 to skip the embedded server and use an external PostgreSQL
CAMPUSIQ_EXTERNAL_DB=0
# Where the embedded server stores its cluster (default: ./.data/pgdata)
PGDATA=./.data/pgdata

# ── Auth ────────────────────────────────────────────────────
# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
# Session lifetime in days
SESSION_TTL_DAYS=7
# Cookie security flag (set false only for plain-http local dev)
COOKIE_SECURE=false

# ── AI provider (optional — the app runs on the built-in mock engine) ──
# Provider: mock | gemini | openai | custom
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# Milliseconds before an AI call falls back to the mock engine
AI_TIMEOUT_MS=20000

# ── File storage (optional) ─────────────────────────────────
# Driver: local | s3
FILE_STORAGE_DRIVER=local
FILE_STORAGE_URL=
FILE_STORAGE_KEY=
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
# Local driver root directory
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=10

# ── Mail (optional — reset tokens are logged when unset) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CampusIQ <no-reply@campusiq.local>"
APP_URL="http://localhost:3000"

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Requests per minute per IP for the public auth endpoints
RATE_LIMIT_PER_MIN=30
