{
  "name": "campusiq",
  "version": "1.0.0",
  "private": true,
  "description": "CampusIQ \u2014 Intelligent Solutions for a Smarter Campus",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/db.mjs migrate",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:deploy": "node scripts/db.mjs migrate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/db.mjs reset",
    "db:studio": "node scripts/prisma.mjs studio",
    "pg:start": "node scripts/pg.mjs start",
    "pg:stop": "node scripts/pg.mjs stop",
    "pg:status": "node scripts/pg.mjs status",
    "setup": "bash scripts/setup.sh",
    "db:diff": "node scripts/prisma.mjs migrate diff",
    "db:status": "node scripts/db.mjs status",
    "db:create": "node scripts/db.mjs create"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
